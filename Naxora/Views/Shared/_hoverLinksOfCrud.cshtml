<style>
    /* Menu Container & Center Button */
    .arc-menu-wrapper {
        width: 58px;
        height: 58px;
        z-index: 1050;
    }

    .arc-trigger {
        width: 58px;
        height: 58px;
        z-index: 30;
        transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

        .arc-trigger i {
            transition: transform 0.35s ease;
        }

    .arc-menu-wrapper:hover .arc-trigger {
        transform: scale(1.08);
    }

        .arc-menu-wrapper:hover .arc-trigger i {
            transform: rotate(90deg);
        }

    /* Circular Quadrant Hover Bridge */
    .arc-menu-wrapper::after {
        content: '';
        position: absolute;
        top: -12px;
        left: -12px;
        width: 320px;
        height: 320px;
        border-radius: 0 0 100% 0;
        pointer-events: none;
        z-index: 10;
    }

    .arc-menu-wrapper:hover::after {
        pointer-events: auto;
    }

    /* Links Base Style (Pivot Center Button ke Center Par Locked Hai) */
    .arc-link {
        position: absolute;
        left: calc(50% + 34px);
        top: calc(50% - 19px);
        height: 38px;
        z-index: 20;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        background-color: #ffffff;
        color: #198754;
        border: 1.5px solid #198754;
        font-size: 0.85rem;
        transform-origin: -34px 50%;
        transform: rotate(0deg) scale(0.2);
        transition: all 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

        .arc-link:hover {
            background-color: #198754 !important;
            color: #ffffff !important;
            border-color: #198754 !important;
            z-index: 45 !important;
            box-shadow: 0 8px 22px rgba(25, 135, 84, 0.35) !important;
        }

            .arc-link:hover i {
                color: #ffffff !important;
            }

    .arc-menu-wrapper:hover .arc-link {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
    }

        /* CIRCULAR PETAL FAN (Angles radiating directly from center hub) */
        /* 1. View All Users (Horizontal-ish) */
        .arc-menu-wrapper:hover .arc-link:nth-child(1) {
            transform: rotate(4deg) scale(1);
            transition-delay: 0.02s;
        }
        /* 2. View All Category (Gentle slope) */
        .arc-menu-wrapper:hover .arc-link:nth-child(2) {
            transform: rotate(27deg) scale(1);
            transition-delay: 0.05s;
        }
        /* 3. View All SubCategory (Diagonal) */
        .arc-menu-wrapper:hover .arc-link:nth-child(3) {
            transform: rotate(51deg) scale(1);
            transition-delay: 0.08s;
        }
        /* 4. View All Product (Down-slanted) */
        .arc-menu-wrapper:hover .arc-link:nth-child(4) {
            transform: rotate(75deg) scale(1);
            transition-delay: 0.11s;
        }

        /* Hover Zoom for Each Link */
        .arc-menu-wrapper:hover .arc-link:nth-child(1):hover {
            transform: rotate(4deg) scale(1.06);
        }

        .arc-menu-wrapper:hover .arc-link:nth-child(2):hover {
            transform: rotate(27deg) scale(1.06);
        }

        .arc-menu-wrapper:hover .arc-link:nth-child(3):hover {
            transform: rotate(51deg) scale(1.06);
        }

        .arc-menu-wrapper:hover .arc-link:nth-child(4):hover {
            transform: rotate(75deg) scale(1.06);
        }
</style>


<div class="arc-menu-wrapper position-relative position-fixed">
    <!-- Central Trigger Button -->
    <button type="button" class="arc-trigger btn btn-success rounded-circle shadow d-flex align-items-center justify-content-center border-0 p-0">
        <i class="fa-solid fa-table-cells fs-5 text-white"></i>
    </button>

    <!-- Links: Sabhi ka ek side center se anchored rehta hai -->
    <div class="position-absolute top-0 start-0 w-100 h-100 pointer-events-none">
        <a class="arc-link btn rounded-pill shadow-sm text-nowrap d-flex align-items-center gap-2 py-1 px-3 fw-medium text-decoration-none"
           asp-area="" asp-controller="Admin" asp-action="index">
            <i class="fa-solid fa-users text-success"></i>
            <span>View All Users</span>
        </a>

        <a class="arc-link btn rounded-pill shadow-sm text-nowrap d-flex align-items-center gap-2 py-1 px-3 fw-medium text-decoration-none"
           asp-area="" asp-controller="products" asp-action="Category">
            <i class="fa-solid fa-tags text-success"></i>
            <span>View All Category</span>
        </a>

        <a class="arc-link btn rounded-pill shadow-sm text-nowrap d-flex align-items-center gap-2 py-1 px-3 fw-medium text-decoration-none"
           asp-area="" asp-controller="products" asp-action="SubCategory">
            <i class="fa-solid fa-sitemap text-success"></i>
            <span>View All SubCategory</span>
        </a>

        <a class="arc-link btn rounded-pill shadow-sm text-nowrap d-flex align-items-center gap-2 py-1 px-3 fw-medium text-decoration-none"
           asp-area="" asp-controller="products" asp-action="Products">
            <i class="fa-solid fa-boxes-stacked text-success"></i>
            <span>View All Product</span>
        </a>
    </div>
</div>