
<form method="post" id="CategoryForm" class="rounded rounded-3">
    <div class="col-10 col-sm-10 col-md-8 col-lg-8 mx-auto border border-1 shadow p-4 my-5">
        <h2 class="text-decoration-underline text-center my-4">Add Category</h2>
        <input type="text" name="c_id" id="c_id" hidden />
        <input type="text" name="c_name" id="c_name" placeholder="Category Name" class="form-control mb-3" />

        <input type="file" accept="image/*" name="CatImg" id="CatImg" class="form-control" />
        <img src="#" id="CatPrvImg" style="display:none" class="img-thumbnail my-3" height="100px" width="100px" />

        <input type="button" id="btn_AddCat" onclick="addEditCategory();" class="btn btn-success form-control my-3 " value="Add Category" />
    </div>
</form>


<div class="container">
    <div class="row">
        <div class="table table-responsive ">
            <table class="table table-hover table-active table-bordered table" id="CatTable">
                <thead class="text-nowrap table-dark">
                    <tr>
                        <th>Sr.</th>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Image</th>
                        <th>Status</th>
                        <th>Added On</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>